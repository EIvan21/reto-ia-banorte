# Copia a .env para desarrollo local. NUNCA subas .env al repositorio.

# --- Obligatorio ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Modelo (opcional; estos son los valores por defecto) ---
MODEL=claude-opus-5
EFFORT=low
MAX_TOKENS=8000
MAX_TOOL_TURNS=6

# --- Seguridad del endpoint (opcional) ---
# Si se define, /v1/responses exige "Authorization: Bearer <valor>".
# Se registra en la plataforma del reto en el campo "Clave de API".
AGENT_API_KEY=

# --- Telemetria en BigQuery (opcional) ---
# Sin estas, la telemetria solo sale como JSON estructurado a stdout.
BQ_PROJECT=
BQ_DATASET=cv_agent
BQ_TABLE=agent_events

# --- Metadatos publicos ---
# Debe apuntar a la URL publica real: alimenta la tarjeta de agente.
PUBLIC_BASE_URL=http://localhost:8080
AGENT_NAME=CV de Edher Diaz
